// app.js
require('dotenv').config();
const express = require('express');
const crypto = require('crypto');
const bcrypt = require('bcrypt');
const rateLimit = require('express-rate-limit');
const nodemailer = require('nodemailer');
const { Pool } = require('pg');

const app = express();
app.use(express.json());

// Config DB (Postgres)
const pool = new Pool({
  connectionString: process.env.DATABASE_URL
});

// Rate limit para endpoints sensibles
const limiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 min
  max: 10, // ajustar según necesidad
  message: { ok: false, msg: 'Demasiadas solicitudes, intenta más tarde.' }
});

// Nodemailer transporter (ejemplo SMTP)
const transporter = nodemailer.createTransport({
  host: process.env.SMTP_HOST,
  port: Number(process.env.SMTP_PORT || 587),
  secure: process.env.SMTP_SECURE === 'true',
  auth: {
    user: process.env.SMTP_USER,
    pass: process.env.SMTP_PASS
  }
});

// Helpers
function generateToken(bytes = 32) {
  return crypto.randomBytes(bytes).toString('hex'); // token en texto plano
}

function hashToken(token) {
  return crypto.createHash('sha256').update(token).digest('hex');
}

// Endpoint: solicitar reset
app.post('/auth/request-password-reset', limiter, async (req, res) => {
  const { email } = req.body;
  if (!email) return res.status(400).json({ ok: false, msg: 'Email requerido' });

  try {
    // No revelar si el correo existe — responder igual en ambos casos
    const client = await pool.connect();
    try {
      const userResult = await client.query('SELECT id FROM users WHERE email = $1', [email]);
      if (userResult.rowCount > 0) {
        const userId = userResult.rows[0].id;

        // Generar token y guardarlo hasheado
        const token = generateToken();
        const tokenHash = hashToken(token);
        const expiresAt = new Date(Date.now() + (1000 * 60 * 60)); // 1 hora

        // Opcional: borrar tokens viejos para el usuario
        await client.query('DELETE FROM password_reset_tokens WHERE user_id = $1', [userId]);

        await client.query(
          `INSERT INTO password_reset_tokens (user_id, token_hash, expires_at, created_at)
           VALUES ($1, $2, $3, now())`,
          [userId, tokenHash, expiresAt]
        );

        // Enviar correo con el token (texto plano)
        const resetUrl = `${process.env.FRONTEND_URL}/reset-password?token=${token}&email=${encodeURIComponent(email)}`;
        const mailOptions = {
          from: process.env.SMTP_FROM,
          to: email,
          subject: 'Restablece tu contraseña',
          text: `Para restablecer tu contraseña, visita: ${resetUrl}\nSi no pediste este correo, ignóralo.`,
          html: `<p>Para restablecer tu contraseña, haz clic <a href="${resetUrl}">aquí</a>.</p>
                 <p>Si no pediste esto, ignora este correo.</p>`
        };
        await transporter.sendMail(mailOptions);
      }
    } finally {
      client.release();
    }

    // Respuesta genérica (no revela si el email existe)
    return res.json({ ok: true, msg: 'Si existe una cuenta con ese correo, se ha enviado un enlace para restablecer la contraseña.' });
  } catch (err) {
    console.error(err);
    return res.status(500).json({ ok: false, msg: 'Error interno' });
  }
});

// Endpoint: realizar reset con token
app.post('/auth/reset-password', limiter, async (req, res) => {
  const { token, email, newPassword } = req.body;
  if (!token || !email || !newPassword) return res.status(400).json({ ok: false, msg: 'Faltan parámetros' });

  // Validaciones de contraseña (ejemplo mínimo)
  if (newPassword.length < 8) return res.status(400).json({ ok: false, msg: 'La contraseña debe tener al menos 8 caracteres' });

  try {
    const tokenHash = hashToken(token);
    const client = await pool.connect();
    try {
      // Obtener user id
      const userRes = await client.query('SELECT id FROM users WHERE email = $1', [email]);
      if (userRes.rowCount === 0) {
        // Respuesta genérica para no filtrar
        return res.status(400).json({ ok: false, msg: 'Token inválido o expirado' });
      }
      const userId = userRes.rows[0].id;

      // Buscar token
      const tokenRes = await client.query(
        `SELECT id, expires_at FROM password_reset_tokens
         WHERE user_id = $1 AND token_hash = $2`,
        [userId, tokenHash]
      );
      if (tokenRes.rowCount === 0) {
        return res.status(400).json({ ok: false, msg: 'Token inválido o expirado' });
      }
      const tokenRow = tokenRes.rows[0];
      const expiresAt = new Date(tokenRow.expires_at);
      if (expiresAt < new Date()) {
        // Borrar el token caducado
        await client.query('DELETE FROM password_reset_tokens WHERE id = $1', [tokenRow.id]);
        return res.status(400).json({ ok: false, msg: 'Token inválido o expirado' });
      }

      // Hashear nueva contraseña y guardar
      const saltRounds = 12;
      const hashedPassword = await bcrypt.hash(newPassword, saltRounds);
      await client.query('UPDATE users SET password_hash = $1, updated_at = now() WHERE id = $2', [hashedPassword, userId]);

      // Eliminar tokens usados
      await client.query('DELETE FROM password_reset_tokens WHERE user_id = $1', [userId]);

      return res.json({ ok: true, msg: 'Contraseña restablecida correctamente' });
    } finally {
      client.release();
    }
  } catch (err) {
    console.error(err);
    return res.status(500).json({ ok: false, msg: 'Error interno' });
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`Server listening on ${PORT}`));
